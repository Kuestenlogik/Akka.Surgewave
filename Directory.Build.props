<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CS1591 (missing XML comment): 215 public members of the libraries are not documented yet;
         the documented ones ship their comments. Kept until the API is documented. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- NuGet audit: every package in the graph, direct and transitive, with an advisory of any severity
         (NU1901-NU1904) fails the restore through TreatWarningsAsErrors. No NuGet warning is suppressed;
         an advisory without a patched version would get one NuGetAuditSuppress item with its link and reason. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <PropertyGroup>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts\</ArtifactsPath>
    <BaseIntermediateOutputPath>$(ArtifactsPath)obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)\</IntermediateOutputPath>
    <BaseOutputPath>$(ArtifactsPath)bin\$(MSBuildProjectName)\</BaseOutputPath>
    <OutputPath>$(BaseOutputPath)$(Configuration)\</OutputPath>
    <PackageOutputPath>$(ArtifactsPath)packages\</PackageOutputPath>
    <PublishDir>$(ArtifactsPath)publish\$(MSBuildProjectName)\$(Configuration)\</PublishDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <!-- XML documentation for the shipped libraries only. Test projects are excluded by name, because
         IsTestProject is set in the project file, after this file is evaluated. -->
    <GenerateDocumentationFile Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn)</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <Authors>Kuestenlogik</Authors>
    <Company>Kuestenlogik</Company>
    <Copyright>Copyright (c) 2026 Küstenlogik</Copyright>
    <PackageTags>akka;surgewave;kafka;message-broker;event-streaming</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Kuestenlogik/Akka.Surgewave</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Kuestenlogik/Akka.Surgewave</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!--
    Versioning is shared across the two packages
    (Kuestenlogik.Akka.Surgewave.Streams + Kuestenlogik.Akka.Surgewave.Persistence)
    so a single tag produces both NuGets at the same version. Bump here for a
    coordinated release.
  -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <Version>0.3.4</Version>
    <!-- AssemblyVersion + FileVersion follow $(Version); the SemVer prerelease
         suffix (e.g. "-ci.X.sha") is stripped, because AssemblyVersion
         strictly accepts only major.minor.build.revision. The Surgewave repo
         uses the same pattern (its Directory.Build.props). -->
    <AssemblyVersion>$([System.Text.RegularExpressions.Regex]::Replace($(Version), '-.*$', ''))</AssemblyVersion>
    <FileVersion>$([System.Text.RegularExpressions.Regex]::Replace($(Version), '-.*$', ''))</FileVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <!--
    Embed icon.png + README.md from the repo root into every NuGet package.
    The source of icon.png is scripts/icon.svg + scripts/generate-icon.js
    (sharp-based render).
  -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Link="icon.png" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)icon.png')" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Link="README.md" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)README.md')" />
  </ItemGroup>

</Project>
