<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Post-launch: all Kuestenlogik.Surgewave.* stable packages are published to
         nuget.org. The former github source 401ed in CI (no org-package read rights)
         and folder sources break restores without a packed sibling clone - add a
         local override temporarily when testing untagged main-repo builds. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
