<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Akka.NET -->
    <PackageVersion Include="Akka" Version="1.5.44" />
    <PackageVersion Include="Akka.Streams" Version="1.5.71" />
    <PackageVersion Include="Akka.Persistence" Version="1.5.71" />
    <PackageVersion Include="Akka.Persistence.Query" Version="1.5.71" />
    <PackageVersion Include="Akka.Persistence.TCK" Version="1.5.69" />
    <PackageVersion Include="Akka.Hosting" Version="1.5.70" />
    <!-- Surgewave (consumed from nuget.org / GitHub Packages) -->
    <PackageVersion Include="Kuestenlogik.Surgewave.Client" Version="0.5.0" />
    <PackageVersion Include="Kuestenlogik.Surgewave.Runtime" Version="0.5.0" />
    <PackageVersion Include="Kuestenlogik.Surgewave.Schema.Registry.Client" Version="0.5.0" />
    <!-- Logging -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.8" />
    <!-- Testing -->
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
  </ItemGroup>
</Project>
